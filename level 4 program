"""
Level 4 – Best iteration
All events, no CV domination, density-first finale
"""

import json
from collections import defaultdict, Counter

INPUT_FILE = "4.json"
OUTPUT_FILE = "level4_submission.json"

GRASS, ROSE_BUSH, BLUE_MOSS = 1, 2, 3
DWARF_SUNFLOWER, LAVENDER = 5, 6
ORANGE_BLOSSOM, CRYSTAL_CACTUS, MIRE_BLOOM = 7, 17, 18


def load_level(path):
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def find_valid_locations(level):
    preferred, secondary = [], []
    for cell in level.get("cells", []):
        t, s = cell.get("terrain"), cell.get("soil")
        entry = {"row": cell["row"], "col": cell["col"]}
        if t == 0 and s in (0, 1):
            preferred.append(entry)
        elif t == 1 and s in (0, 1):
            secondary.append(entry)
        elif t == 0 and s == 2:
            secondary.append(entry)
    return preferred + secondary


def create_submission(level):
    locations = find_valid_locations(level)
    n = len(locations)
    print(f"[INFO] Locations: {n}")

    ticks = level.get("ticks", 800)
    max_per = 20
    by_tick = defaultdict(list)

    def add(tick, idx, row, col):
        if 0 <= tick < ticks - 1:
            by_tick[tick].append({
                "plant_index": idx, "row": row, "col": col
            })

    def spread(start, end, mix, stride=1, max_actions=None):
        if n == 0:
            return
        total = (end - start + 1) * max_per
        if max_actions:
            total = min(total, max_actions)
        for i in range(total):
            t = start + (i // max_per)
            if t > end or t >= ticks - 1:
                break
            loc = locations[(i * stride) % n]
            add(t, mix[i % len(mix)], loc["row"], loc["col"])

    # P1 (0-45): starters before Rain
    mix1 = [GRASS]*10 + [ROSE_BUSH]*5 + [LAVENDER]*3 + [DWARF_SUNFLOWER]*2
    spread(0, 45, mix1, stride=1, max_actions=1000)

    # P2a (50-65): Rain – Blue Moss
    mix2a = [GRASS]*4 + [LAVENDER]*3 + [ROSE_BUSH]*3 + [DWARF_SUNFLOWER]*2 + [BLUE_MOSS]*6 + [ORANGE_BLOSSOM]*2
    spread(50, 65, mix2a, stride=7, max_actions=400)

    # P2b (66-120): Mire Bloom
    mix2b = [GRASS]*4 + [LAVENDER]*3 + [ROSE_BUSH]*3 + [DWARF_SUNFLOWER]*2 + [BLUE_MOSS]*3 + [MIRE_BLOOM]*4 + [ORANGE_BLOSSOM]*1
    spread(66, 120, mix2b, stride=11, max_actions=900)

    # P3 (130-220): Heavy Grass for Crystal Cactus
    mix3 = [GRASS]*12 + [LAVENDER]*3 + [ROSE_BUSH]*3 + [DWARF_SUNFLOWER]*1 + [BLUE_MOSS]*1
    spread(130, 220, mix3, stride=13, max_actions=1400)

    # P4 (230-275): Ash Eclipse + pre-Drought Grass
    mix4 = [GRASS]*10 + [LAVENDER]*3 + [ROSE_BUSH]*3 + [DWARF_SUNFLOWER]*2 + [BLUE_MOSS]*1 + [MIRE_BLOOM]*1
    spread(230, 275, mix4, stride=17, max_actions=700)

    # P5 (280-350): Crystal Cactus after Drought
    mix5 = [GRASS]*4 + [LAVENDER]*3 + [ROSE_BUSH]*2 + [DWARF_SUNFLOWER]*2 + [CRYSTAL_CACTUS]*6 + [BLUE_MOSS]*2 + [MIRE_BLOOM]*1
    spread(280, 350, mix5, stride=19, max_actions=1000)

    # P6 (400-520): Re-establish
    mix6 = [GRASS]*6 + [LAVENDER]*4 + [ROSE_BUSH]*3 + [DWARF_SUNFLOWER]*2 + [CRYSTAL_CACTUS]*2 + [BLUE_MOSS]*2 + [MIRE_BLOOM]*1
    spread(400, 520, mix6, stride=23, max_actions=1200)

    # P7 (580-680): Mid-late
    mix7 = [GRASS]*5 + [LAVENDER]*4 + [ROSE_BUSH]*3 + [DWARF_SUNFLOWER]*3 + [CRYSTAL_CACTUS]*2 + [BLUE_MOSS]*2 + [MIRE_BLOOM]*1
    spread(580, 680, mix7, stride=29, max_actions=800)

    # P8 (720-790): Final density after Earthquake
    final = [
        GRASS, LAVENDER, ROSE_BUSH, DWARF_SUNFLOWER,
        BLUE_MOSS, MIRE_BLOOM, CRYSTAL_CACTUS, ORANGE_BLOSSOM,
        GRASS, LAVENDER, ROSE_BUSH, DWARF_SUNFLOWER,
        BLUE_MOSS, MIRE_BLOOM, CRYSTAL_CACTUS, LAVENDER,
        GRASS, LAVENDER, ROSE_BUSH, DWARF_SUNFLOWER
    ]
    spread(720, 790, final, stride=3, max_actions=1400)

    actions = []
    for tick in sorted(by_tick.keys()):
        plants = by_tick[tick][:max_per]
        if plants:
            actions.append({"tick": tick, "plants": plants})
    return {"actions": actions}


if __name__ == "__main__":
    level = load_level(INPUT_FILE)
    submission = create_submission(level)
    total = sum(len(a["plants"]) for a in submission["actions"])
    print(f"Total: {total}")
    cnt = Counter()
    for a in submission["actions"]:
        for p in a["plants"]:
            cnt[p["plant_index"]] += 1
    print("Counts:", dict(sorted(cnt.items())))
    with open(OUTPUT_FILE, "w") as f:
        json.dump(submission, f, indent=2)
    print(f"Wrote {OUTPUT_FILE}")