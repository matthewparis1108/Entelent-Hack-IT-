"""
Level 3 – focus on Crystal Cactus (Drought) + Mire Bloom (Rain)
"""

import json
from collections import defaultdict

INPUT_FILE = "3.json"
OUTPUT_FILE = "level3_submission.json"


def load_level():
    with open(INPUT_FILE, "r", encoding="utf-8") as f:
        return json.load(f)


def find_valid_locations(level):
    preferred, secondary = [], []
    for cell in level.get("cells", []):
        t, s = cell.get("terrain"), cell.get("soil")
        if t == 0 and s in (0, 1):
            preferred.append({"row": cell["row"], "col": cell["col"]})
        elif t == 1 and s in (0, 1):
            secondary.append({"row": cell["row"], "col": cell["col"]})
        elif t == 0 and s == 2:
            secondary.append({"row": cell["row"], "col": cell["col"]})
    return preferred + secondary


def create_submission(level):
    locations = find_valid_locations(level)
    print(f"Found {len(locations)} locations")

    ticks = level.get("ticks", 800)
    max_per = 20
    n = len(locations)

    G, R, S, L = 1, 2, 5, 6
    BM, OB, MB, CC = 3, 7, 18, 17

    by_tick = defaultdict(list)

    def plant(tick, idx, row, col):
        if 0 <= tick < ticks - 1:
            by_tick[tick].append({
                "plant_index": idx, "row": row, "col": col
            })

    # PHASE 1 (0-9): ONLY Grass for Crystal Cactus at Drought@10
    for i in range(min(200, n)):
        t = i // max_per
        if t > 9:
            break
        loc = locations[i % n]
        plant(t, G, loc["row"], loc["col"])

    # PHASE 2 (12-80): starters + Crystal Cactus
    for i in range(min(1000, n * 2)):
        t = 12 + (i // max_per)
        if t > 80:
            break
        loc = locations[(i * 3) % n]
        choice = i % 20
        if choice < 8:
            p = G
        elif choice < 12:
            p = R
        elif choice < 15:
            p = L
        elif choice < 17:
            p = S
        elif choice < 19:
            p = CC
        else:
            p = BM
        plant(t, p, loc["row"], loc["col"])

    # PHASE 3 (100-140): pre-Rain Blue Moss path
    for i in range(min(600, n)):
        t = 100 + (i // max_per)
        if t > 140:
            break
        loc = locations[(i * 7) % n]
        choice = i % 20
        if choice < 6:
            p = G
        elif choice < 10:
            p = L
        elif choice < 13:
            p = R
        elif choice < 15:
            p = S
        elif choice < 17:
            p = BM
        elif choice < 19:
            p = CC
        else:
            p = OB
        plant(t, p, loc["row"], loc["col"])

    # PHASE 4 (150-220): Rain → Blue Moss then Mire Bloom
    for i in range(min(800, n * 2)):
        t = 150 + (i // max_per)
        if t > 220:
            break
        loc = locations[(i * 11) % n]
        choice = i % 20
        if t < 160:
            if choice < 5:
                p = G
            elif choice < 8:
                p = L
            elif choice < 11:
                p = R
            elif choice < 13:
                p = S
            else:
                p = BM
        else:
            if choice < 4:
                p = G
            elif choice < 7:
                p = L
            elif choice < 10:
                p = R
            elif choice < 12:
                p = S
            elif choice < 15:
                p = BM
            elif choice < 18:
                p = MB
            else:
                p = CC
        plant(t, p, loc["row"], loc["col"])

    # PHASE 5 (300-380): post Ash Eclipse
    for i in range(min(600, n)):
        t = 300 + (i // max_per)
        if t > 380:
            break
        loc = locations[(i * 13) % n]
        choice = i % 20
        if choice < 5:
            p = G
        elif choice < 9:
            p = L
        elif choice < 12:
            p = R
        elif choice < 14:
            p = S
        elif choice < 16:
            p = BM
        elif choice < 18:
            p = MB
        else:
            p = CC
        plant(t, p, loc["row"], loc["col"])

    # PHASE 6 (500-580)
    for i in range(min(500, n)):
        t = 500 + (i // max_per)
        if t > 580:
            break
        loc = locations[(i * 17) % n]
        choice = i % 20
        if choice < 5:
            p = G
        elif choice < 9:
            p = L
        elif choice < 12:
            p = R
        elif choice < 14:
            p = S
        elif choice < 16:
            p = BM
        elif choice < 18:
            p = MB
        else:
            p = CC
        plant(t, p, loc["row"], loc["col"])

    # PHASE 7 (700-790): final diversity
    final_mix = [G, L, R, S, BM, MB, CC, OB, G, L, R, S, BM, MB, CC, L]
    for i in range(min(1000, n * 2)):
        t = 700 + (i // max_per)
        if t >= ticks - 1:
            break
        loc = locations[i % n]
        plant(t, final_mix[i % len(final_mix)], loc["row"], loc["col"])

    actions = []
    for tick in sorted(by_tick.keys()):
        plants = by_tick[tick][:max_per]
        if plants:
            actions.append({"tick": tick, "plants": plants})
    return {"actions": actions}


if __name__ == "__main__":
    level = load_level()
    submission = create_submission(level)
    total = sum(len(a["plants"]) for a in submission["actions"])
    print(f"Total: {total}")
    from collections import Counter
    cnt = Counter()
    for a in submission["actions"]:
        for p in a["plants"]:
            cnt[p["plant_index"]] += 1
    print("Counts:", dict(sorted(cnt.items())))
    with open(OUTPUT_FILE, "w") as f:
        json.dump(submission, f, indent=2)
    print(f"Wrote {OUTPUT_FILE}")