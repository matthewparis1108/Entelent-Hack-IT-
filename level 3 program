"""
Level 3 – Density-first (Level 1 baseline)
No Crimson Vine, no Crystal Cactus
"""

import json
from collections import defaultdict, Counter

INPUT_FILE = "3.json"
OUTPUT_FILE = "level3_submission.json"

GRASS, ROSE_BUSH, BLUE_MOSS = 1, 2, 3
DWARF_SUNFLOWER, LAVENDER = 5, 6
ORANGE_BLOSSOM, MIRE_BLOOM = 7, 18


def load_level(path):
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def find_valid_locations(level):
    preferred, secondary = [], []
    for cell in level.get("cells", []):
        t, s = cell.get("terrain"), cell.get("soil")
        entry = {"row": cell["row"], "col": cell["col"]}
        if t == 0 and s in (0, 1):
            preferred.append(entry)
        elif t == 1 and s in (0, 1):
            secondary.append(entry)
        elif t == 0 and s == 2:
            secondary.append(entry)
    return preferred + secondary


def create_submission(level):
    locations = find_valid_locations(level)
    n = len(locations)
    print(f"[INFO] Locations: {n}")

    ticks = level.get("ticks", 800)
    max_per = 20
    by_tick = defaultdict(list)

    def add(tick, idx, row, col):
        if 0 <= tick < ticks - 1:
            by_tick[tick].append({
                "plant_index": idx, "row": row, "col": col
            })

    def spread(start, end, mix, stride=1, max_actions=None):
        if n == 0:
            return
        total = (end - start + 1) * max_per
        if max_actions:
            total = min(total, max_actions)
        for i in range(total):
            t = start + (i // max_per)
            if t > end or t >= ticks - 1:
                break
            loc = locations[(i * stride) % n]
            add(t, mix[i % len(mix)], loc["row"], loc["col"])

    # PHASE 1 (15-100): AFTER Drought – rebuild hard
    mix1 = [GRASS]*10 + [ROSE_BUSH]*5 + [LAVENDER]*3 + [DWARF_SUNFLOWER]*2
    spread(15, 100, mix1, stride=1, max_actions=1400)

    # PHASE 2 (110-145): pre-Rain
    mix2 = [GRASS]*6 + [LAVENDER]*5 + [ROSE_BUSH]*4 + [DWARF_SUNFLOWER]*3 + [BLUE_MOSS]*2
    spread(110, 145, mix2, stride=7, max_actions=600)

    # PHASE 3 (150-220): Rain – Blue Moss / Mire Bloom tries
    mix3a = [GRASS]*5 + [LAVENDER]*4 + [ROSE_BUSH]*3 + [DWARF_SUNFLOWER]*2 + [BLUE_MOSS]*6
    spread(150, 165, mix3a, stride=11, max_actions=400)
    mix3b = [GRASS]*5 + [LAVENDER]*4 + [ROSE_BUSH]*3 + [DWARF_SUNFLOWER]*2 + [BLUE_MOSS]*3 + [MIRE_BLOOM]*2 + [ORANGE_BLOSSOM]*1
    spread(166, 220, mix3b, stride=13, max_actions=700)

    # PHASE 4 (300-400): post Ash Eclipse – pure starters
    mix4 = [GRASS]*6 + [LAVENDER]*5 + [ROSE_BUSH]*4 + [DWARF_SUNFLOWER]*3 + [BLUE_MOSS]*1 + [MIRE_BLOOM]*1
    spread(300, 400, mix4, stride=17, max_actions=1000)

    # PHASE 5 (500-600)
    mix5 = [GRASS]*6 + [LAVENDER]*5 + [ROSE_BUSH]*4 + [DWARF_SUNFLOWER]*3 + [BLUE_MOSS]*1 + [MIRE_BLOOM]*1
    spread(500, 600, mix5, stride=19, max_actions=800)

    # PHASE 6 (700-790): FINAL density (Level 1 style)
    final = [GRASS, LAVENDER, ROSE_BUSH, DWARF_SUNFLOWER,
             GRASS, LAVENDER, ROSE_BUSH, DWARF_SUNFLOWER,
             GRASS, LAVENDER, ROSE_BUSH, DWARF_SUNFLOWER,
             BLUE_MOSS, MIRE_BLOOM, GRASS, LAVENDER]
    spread(700, 790, final, stride=3, max_actions=1400)

    actions = []
    for tick in sorted(by_tick.keys()):
        plants = by_tick[tick][:max_per]
        if plants:
            actions.append({"tick": tick, "plants": plants})
    return {"actions": actions}


if __name__ == "__main__":
    level = load_level(INPUT_FILE)
    submission = create_submission(level)
    total = sum(len(a["plants"]) for a in submission["actions"])
    print(f"Total: {total}")
    cnt = Counter()
    for a in submission["actions"]:
        for p in a["plants"]:
            cnt[p["plant_index"]] += 1
    print("Counts:", dict(sorted(cnt.items())))
    with open(OUTPUT_FILE, "w") as f:
        json.dump(submission, f, indent=2)
    print(f"Wrote {OUTPUT_FILE}")