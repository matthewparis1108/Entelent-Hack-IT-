"""
Level 2 solution
"""

import json
from collections import defaultdict

# ========== CHANGE THESE ==========
INPUT_FILE = "2.json"                 # or "2(1).json"
OUTPUT_FILE = "level2_submission.json"
# ==================================


def load_level():
    with open(INPUT_FILE, "r", encoding="utf-8") as f:
        return json.load(f)


def find_valid_locations(level):
    preferred, secondary = [], []
    for cell in level.get("cells", []):
        t, s = cell.get("terrain"), cell.get("soil")
        if t == 0 and s in (0, 1):
            preferred.append({"row": cell["row"], "col": cell["col"]})
        elif t in (0, 1) and s in (0, 1, 2):
            secondary.append({"row": cell["row"], "col": cell["col"]})
    return preferred + secondary


def create_submission(level):
    locations = find_valid_locations(level)
    print(f"Found {len(locations)} usable locations")

    ticks = level.get("ticks", 500)
    max_per = 20
    n = len(locations)

    G, R, S, L, O = 1, 2, 5, 6, 12
    BM, CV, OB, MB = 3, 4, 7, 18

    by_tick = defaultdict(list)

    def plant(tick, idx, row, col):
        if 0 <= tick < ticks - 1:
            by_tick[tick].append({
                "plant_index": idx,
                "row": row,
                "col": col
            })

    # PHASE 1 (0-50): MAX Grass + Rose → Loamcrawlers / Verdelopes
    for i in range(min(600, n * 2)):
        t = i // max_per
        if t > 50:
            break
        loc = locations[i % n]
        choice = i % 20
        if choice < 13:
            p = G
        elif choice < 17:
            p = R
        elif choice < 19:
            p = L
        else:
            p = S
        plant(t, p, loc["row"], loc["col"])

    # PHASE 2 (60-150): diversity + try Blue Moss
    for i in range(min(500, n)):
        t = 60 + (i // max_per)
        if t > 150:
            break
        loc = locations[(i * 7) % n]
        choice = i % 20
        if choice < 8:
            p = G
        elif choice < 12:
            p = L
        elif choice < 15:
            p = R
        elif choice < 17:
            p = S
        else:
            p = BM
        plant(t, p, loc["row"], loc["col"])

    # PHASE 3 (200-280): Rain window – Blue Moss then Mire Bloom
    for i in range(min(500, n)):
        t = 200 + (i // max_per)
        if t > 280:
            break
        loc = locations[(i * 11) % n]
        choice = i % 20
        if t < 250:
            if choice < 6:
                p = G
            elif choice < 10:
                p = L
            elif choice < 13:
                p = R
            elif choice < 15:
                p = S
            else:
                p = BM
        else:
            if choice < 5:
                p = G
            elif choice < 8:
                p = L
            elif choice < 11:
                p = R
            elif choice < 13:
                p = S
            elif choice < 16:
                p = BM
            elif choice < 19:
                p = MB
            else:
                p = OB
        plant(t, p, loc["row"], loc["col"])

    # PHASE 4 (300-380): second unlock wave
    for i in range(min(400, n)):
        t = 300 + (i // max_per)
        if t > 380:
            break
        loc = locations[(i * 13) % n]
        choice = i % 20
        if choice < 5:
            p = G
        elif choice < 9:
            p = L
        elif choice < 12:
            p = R
        elif choice < 14:
            p = S
        elif choice < 16:
            p = BM
        elif choice < 18:
            p = MB
        else:
            p = OB
        plant(t, p, loc["row"], loc["col"])

    # PHASE 5 (420-490): final diversity – minimal Oak
    final_mix = [G, L, R, S, BM, MB, OB, CV, L, G, R, S, BM, MB]
    for i in range(min(700, n * 2)):
        t = 420 + (i // max_per)
        if t >= ticks - 1:
            break
        loc = locations[i % n]
        plant(t, final_mix[i % len(final_mix)], loc["row"], loc["col"])

    actions = []
    for tick in sorted(by_tick.keys()):
        plants = by_tick[tick][:max_per]
        if plants:
            actions.append({"tick": tick, "plants": plants})

    return {"actions": actions}


if __name__ == "__main__":
    level = load_level()
    submission = create_submission(level)

    total = sum(len(a["plants"]) for a in submission["actions"])
    print(f"Total plant actions: {total}")
    print(f"Tick groups: {len(submission['actions'])}")

    from collections import Counter
    cnt = Counter()
    for a in submission["actions"]:
        for p in a["plants"]:
            cnt[p["plant_index"]] += 1
    print("Plant counts:", dict(sorted(cnt.items())))

    with open(OUTPUT_FILE, "w", encoding="utf-8") as f:
        json.dump(submission, f, indent=2)
    print(f"Wrote {OUTPUT_FILE}")